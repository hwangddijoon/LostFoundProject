# .env는 저장소에 올리지 않습니다.

# 보관소 담당자 계정. 이 이메일로 가입하면 보관소 관리 메뉴가 보입니다.
# 담당자 이메일은 Gmail 등 다른 주소도 됩니다.
STAFF_EMAILS=

# Gemini: Google AI Studio에서 발급받은 키
ENABLE_AI=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 인증 메일 (SMTP). 비워 두면 메일을 보내지 않고 앱 로그(docker compose logs app)에 인증번호를 찍습니다.
# Gmail 예: MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=보내는 Gmail 주소, MAIL_PASSWORD=Google 앱 비밀번호 16자리, MAIL_FROM은 MAIL_USERNAME과 같음.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 내 로컬 PC에서만 접속: 127.0.0.1 / AWS EC2에서 외부 접속 허용: 0.0.0.0
APP_BIND=
# HTTPS로 서비스할 때만 1 (http에서 1이면 로그인 쿠키가 전송되지 않음)
COOKIE_SECURE=0

# 도커 ID/이미지
APP_IMAGE=
